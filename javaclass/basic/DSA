	static void insertEnd(int ele){
		Node cur=new Node();
		cur.data=ele;
		cur.next=null;
		if(head==null)
		{
			
			head=cur;
			return ;
		}
		Node ptr=head;
		while(ptr.next!=null)
		{
			ptr=ptr.next;
		}
		ptr.next=cur;
		System.out.println(ele+" data inserted at the end!");

	}
	static void disp()
	{
		System.out.println("elements are: ");
		Node ptr=head;
		while(ptr!=null)
		{
			System.out.println(ptr.data);
			ptr=ptr.next;
		}
	}
}
